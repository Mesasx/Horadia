# Upstash Redis (inyectado por la integración de Vercel)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash QStash (inyectado por la integración de Vercel)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Web Push. Genera una sola pareja con: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://example.com

# Vercel la envía como Authorization: Bearer ... al cron diario.
CRON_SECRET=
